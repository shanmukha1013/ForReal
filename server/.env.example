# Copy to server/.env and fill in real values. Never commit server/.env.
NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/forreal

# Use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret
# Optional: defaults to a value derived from JWT_SECRET
JWT_REFRESH_SECRET=

# Allowed browser origin(s) for CORS and cookies, comma-separated
CLIENT_URL=http://localhost:5173
